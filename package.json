{
  "name": "@aghost-prj/dsh-auto-review-model",
  "version": "0.1.0",
  "description": "Pick a dedicated provider/model for DSH Auto-review authorization checks · 为 DSH 自动授权审查单独指定 provider/model",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/AghostPrj/dsh-auto-review-model.git"
  },
  "homepage": "https://github.com/AghostPrj/dsh-auto-review-model#readme",
  "bugs": {
    "url": "https://github.com/AghostPrj/dsh-auto-review-model/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "tsconfig.json",
    "tsconfig.client.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "check": "node --check lib/index.js && node --check lib/policy.js && node --check client/client.js",
    "test": "npm run build && npm run build:tests && node --test .build/tests/*.test.js",
    "verify": "npm run build && npm run build:tests && node .build/scripts/verify.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auto-review",
    "permission",
    "model",
    "reasoning-effort"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
